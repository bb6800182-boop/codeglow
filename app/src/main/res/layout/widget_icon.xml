<?xml version="1.0" encoding="utf-8"?>
<!-- 單一圖示小工具（4×1）收起來的樣子：背景透明，只有一個店家圖示、沒有文字。
     分成 1:2:1 三格，圖示放在第一格、中間或最後一格的正中間（靠左／置中／靠右），跟桌面上其他 App 圖示對齊；
     只有圖示可以點（透明的地方點了不做事）。點了換成 widget_single 的白底條碼，由 Widgets.icon() 處理。
     還沒選條碼、或那張被刪了，中間顯示白底的「選擇條碼」（直接放在桌布上字會看不清楚）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/icon_start"
            android:layout_width="@dimen/icon"
            android:layout_height="@dimen/icon"
            android:layout_gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2">

        <ImageView
            android:id="@+id/icon_center"
            android:layout_width="@dimen/icon"
            android:layout_height="@dimen/icon"
            android:layout_gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/icon_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/widget_bg"
            android:padding="@dimen/space_sm"
            android:text="@string/widget_pick"
            android:textColor="@color/secondary"
            android:textSize="@dimen/text_caption" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/icon_end"
            android:layout_width="@dimen/icon"
            android:layout_height="@dimen/icon"
            android:layout_gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
